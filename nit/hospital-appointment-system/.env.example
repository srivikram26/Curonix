# ============================================================
# AI-Based Hospital Appointment Scheduling System
# Environment Configuration File
# ============================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=change-me-to-a-strong-secret-key
PORT=5001

# Database Configuration
# Local SQLite fallback is automatic when DATABASE_URL is not provided.
# Production MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/hospital_scheduler
DATABASE_URL=

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-strong-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# Mail Configuration (Simulation)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Doctor onboarding domain allow-list
DOCTOR_ALLOWED_EMAIL_DOMAINS=hospital.com

# Application Settings
APPOINTMENTS_PER_SLOT=1
SLOT_DURATION_MINUTES=30
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:00
